generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(uuid()) @db.Uuid
  email           String   @unique
  passwordHash    String   @map("password_hash")
  username        String   @unique
  roles           String[]
  fullName        String?  @map("full_name")
  photoUrl        String?  @map("photo_url")
  githubUrl       String?  @map("github_url")
  linkedinUrl     String?  @map("linkedin_url")
  job             String?
  workplace       String?
  yearsExperience Int?     @map("years_experience")
  techStack       String[] @map("tech_stack")
  createdAt       DateTime @default(now()) @map("created_at")
  mentorProfile   MentorProfile?
  notifications   Notification[]
  outcomeResponses MeetingOutcomeResponse[]
  feedbacks       Feedback[]
  feedbackRequests FeedbackRequest[]
  menteeBlocks    MentorMenteeBlock[] @relation("MenteeBlocks")
  mentorBlocks    MentorMenteeBlock[] @relation("MentorBlocks")
  meetingsAsMentee Meeting[] @relation("MenteeMeetings")
  meetingsAsMentor Meeting[] @relation("MentorMeetings")

  @@map("users")
}

model Meeting {
  id            String            @id @default(uuid()) @db.Uuid
  menteeId      String            @map("mentee_id") @db.Uuid
  mentorId      String            @map("mentor_id") @db.Uuid
  status        String            @default("pending_mentor_times")
  scheduledTime DateTime?         @map("scheduled_time")
  moreTimesUsed          Boolean  @default(false) @map("more_times_used")
  rescheduleUsed         Boolean  @default(false) @map("reschedule_used")
  retryAfterNoshowUsed   Boolean  @default(false) @map("retry_after_noshow_used")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  mentee        User              @relation("MenteeMeetings", fields: [menteeId], references: [id], onDelete: Cascade)
  mentor        User              @relation("MentorMeetings", fields: [mentorId], references: [id], onDelete: Cascade)
  timeSlots     MeetingTimeSlot[]

  @@index([mentorId, status])
  @@index([menteeId, status])
  @@map("meetings")
}

model MeetingTimeSlot {
  id        String   @id @default(uuid()) @db.Uuid
  meetingId String   @map("meeting_id") @db.Uuid
  startTime DateTime @map("start_time")
  endTime   DateTime @map("end_time")
  createdAt DateTime @default(now()) @map("created_at")
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@map("meeting_time_slots")
}

model Notification {
  id                String                 @id @default(uuid()) @db.Uuid
  recipientId       String                 @map("recipient_id") @db.Uuid
  meetingId         String?                @map("meeting_id") @db.Uuid
  type              String
  title             String
  message           String
  actionUrl         String?                @map("action_url")
  popupEligible     Boolean                @default(true) @map("popup_eligible")
  deduplicationKey  String                 @unique @map("deduplication_key")
  readAt            DateTime?              @map("read_at")
  actionCompletedAt DateTime?              @map("action_completed_at")
  createdAt         DateTime               @default(now()) @map("created_at")
  recipient         User                   @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  deliveries        NotificationDelivery[]

  @@index([recipientId, createdAt])
  @@map("notifications")
}

model NotificationDelivery {
  id                String       @id @default(uuid()) @db.Uuid
  notificationId    String       @map("notification_id") @db.Uuid
  channel           String
  status            String
  attemptCount      Int          @default(0) @map("attempt_count")
  nextAttemptAt     DateTime?     @map("next_attempt_at")
  sentAt            DateTime?     @map("sent_at")
  providerMessageId String?       @map("provider_message_id")
  errorMessage      String?       @map("error_message")
  createdAt         DateTime      @default(now()) @map("created_at")
  notification      Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([channel, status, nextAttemptAt])
  @@map("notification_deliveries")
}

model MentorProfile {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @unique @map("user_id") @db.Uuid
  background            String
  adviceTopics          String[] @map("advice_topics")
  meetingsOffered       Int      @map("meetings_offered")
  meetingLengthMinutes  Int      @map("meeting_length_minutes")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mentor_profiles")
}

// meetingId is a UUID without FK — Dev 2 owns the meetings table.
model MeetingOutcomeResponse {
  id              String   @id @default(uuid()) @db.Uuid
  meetingId       String   @map("meeting_id") @db.Uuid
  respondentId    String   @map("respondent_id") @db.Uuid
  role            String
  happened        Boolean
  absentParty     String?  @map("absent_party")
  stillWantToMeet Boolean? @map("still_want_to_meet")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  respondent      User     @relation(fields: [respondentId], references: [id], onDelete: Cascade)

  @@unique([meetingId, respondentId])
  @@index([meetingId])
  @@map("meeting_outcome_responses")
}

model Feedback {
  id          String   @id @default(uuid()) @db.Uuid
  meetingId   String   @map("meeting_id") @db.Uuid
  submittedBy String   @map("submitted_by") @db.Uuid
  rating      Int
  openText    String?  @map("open_text")
  createdAt   DateTime @default(now()) @map("created_at")
  submitter   User     @relation(fields: [submittedBy], references: [id], onDelete: Cascade)

  @@unique([meetingId, submittedBy])
  @@index([meetingId])
  @@map("feedbacks")
}

model FeedbackRequest {
  id                  String    @id @default(uuid()) @db.Uuid
  meetingId           String    @map("meeting_id") @db.Uuid
  recipientId         String    @map("recipient_id") @db.Uuid
  feedbackRequestedAt DateTime  @map("feedback_requested_at")
  fulfilledAt         DateTime? @map("fulfilled_at")
  recipient           User      @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([meetingId, recipientId])
  @@index([fulfilledAt, feedbackRequestedAt])
  @@map("feedback_requests")
}

model MentorMenteeBlock {
  id        String    @id @default(uuid()) @db.Uuid
  menteeId  String    @map("mentee_id") @db.Uuid
  mentorId  String    @map("mentor_id") @db.Uuid
  meetingId String?   @map("meeting_id") @db.Uuid
  reason    String?
  createdAt DateTime  @default(now()) @map("created_at")
  clearedAt DateTime? @map("cleared_at")
  mentee    User      @relation("MenteeBlocks", fields: [menteeId], references: [id], onDelete: Cascade)
  mentor    User      @relation("MentorBlocks", fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([menteeId, mentorId])
  @@index([clearedAt])
  @@map("mentor_mentee_blocks")
}
