PORT=5001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/queens_match
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
BCRYPT_ROUNDS=12
CORS_ORIGINS=http://localhost:3000,http://localhost:5001,http://127.0.0.1:3000,http://127.0.0.1:5001
REQUEST_BODY_LIMIT=32kb
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Mentor vector-search provider configuration
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
# Optional mentor query-understanding and local ranking diagnostics
GEMINI_QUERY_UNDERSTANDING_MODEL=gemini-2.5-flash
MENTOR_SEARCH_DEBUG=false

NOTIFICATION_PROVIDER=console
NOTIFICATION_JOBS_CRON=0 * * * *
# Optional notification job / email timing overrides (milliseconds)
NOTIFICATION_REMINDER_LEAD_MS=
NOTIFICATION_SCAN_WINDOW_MS=
NOTIFICATION_FEEDBACK_INTERVAL_MS=
NOTIFICATION_EMAIL_DELAY_MS=
# Frontend origin used to build absolute email links. Falls back to http://localhost:3000.
APP_URL=
FRONTEND_URL=
NEXT_PUBLIC_APP_URL=

# Production / hosted Postgres (Neon, Render, Railway):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# DATABASE_SSL=true   # optional override; usually implied by sslmode=require

# Optional legacy Brevo email provider configuration
EMAIL_HOST=
EMAIL_PORT=
EMAIL_SECURE=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# Optional WhatsApp provider configuration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_EMAIL_FROM=
TWILIO_EMAIL_FROM_NAME=Queen's Match
# WhatsApp delivery is enabled only with NOTIFICATION_PROVIDER=whatsapp and all three Twilio values.
