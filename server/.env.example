PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/queens_match
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=12
NOTIFICATION_PROVIDER=console
NOTIFICATION_JOBS_CRON=0 * * * *

# Optional Railway-style database variables may be configured by the host.
# Optional email provider configuration
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# Optional WhatsApp provider configuration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
