PORT=5001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/queens_match
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
BCRYPT_ROUNDS=12
CORS_ORIGINS=http://localhost:3000,http://localhost:5001,http://127.0.0.1:3000,http://127.0.0.1:5001
REQUEST_BODY_LIMIT=32kb
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# LinkedIn "Sign In with LinkedIn using OpenID Connect" (used to pull the
# member's profile photo). Create a free app at https://developer.linkedin.com/,
# add the OpenID Connect product, and register the redirect URL below.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:5001/api/auth/linkedin/callback
# Public app origin (email action links + LinkedIn return). Production example:
# CLIENT_URL=https://queenb-task-management-application.onrender.com
CLIENT_URL=http://localhost:3000

# Mentor vector-search provider configuration
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
# Optional mentor query-understanding and local ranking diagnostics
GEMINI_QUERY_UNDERSTANDING_MODEL=gemini-2.5-flash
MENTOR_SEARCH_DEBUG=false

# Production email path: NOTIFICATION_PROVIDER=email with Gmail App Password.
NOTIFICATION_PROVIDER=console
# Meeting reminder / post-meeting / feedback jobs. Default in code is every 5 minutes.
NOTIFICATION_JOBS_CRON=*/5 * * * *
# Optional notification job / email timing overrides (milliseconds)
NOTIFICATION_REMINDER_LEAD_MS=
NOTIFICATION_SCAN_WINDOW_MS=
NOTIFICATION_FEEDBACK_INTERVAL_MS=
# 0 = mail every eligible notification immediately (production setting).
# Important prompts (post_meeting_check, feedback_request, meeting_cancelled)
# are always sent immediately regardless of this value.
NOTIFICATION_EMAIL_DELAY_MS=0

# Production / hosted Postgres (Neon, Render, Railway):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# DATABASE_SSL=true   # optional override; usually implied by sslmode=require

# Neon Auth (Managed Better Auth) — Google OAuth bridge
# Public Auth Base URL from Neon Console → Auth → Configuration
# MUST include /<database>/auth (JWKS is at {NEON_AUTH_BASE_URL}/.well-known/jwks.json).
# Origin-only values 404 the JWKS and break Google sign-in verification.
NEON_AUTH_BASE_URL=https://ep-cold-math-b258daz2.neonauth.c-6.eu-central-1.aws.neon.tech/neondb/auth

# Gmail SMTP via Nodemailer (NOTIFICATION_PROVIDER=email).
# Defaults to smtp.gmail.com:465 over IPv4. SMTP_PASSWORD must be a Gmail App Password.
# These three plus CLIENT_URL are the only variables production email needs.
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Optional overrides for non-Gmail SMTP. Leave unset for Gmail — a blank value
# is treated as unset, so it never overrides smtp.gmail.com:465/secure.
# EMAIL_HOST=
# EMAIL_PORT=
# EMAIL_SECURE=
# EMAIL_USER=
# EMAIL_PASSWORD=

# Optional WhatsApp provider configuration (NOTIFICATION_PROVIDER=whatsapp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_EMAIL_FROM=
TWILIO_EMAIL_FROM_NAME=Queen's Match
# WhatsApp delivery is enabled only with NOTIFICATION_PROVIDER=whatsapp and all three Twilio values.
